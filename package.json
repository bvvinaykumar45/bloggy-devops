{
  "name": "bloggy-devops",
  "version": "1.0.0",
  "description": "A simple blog application, mainly focusing on learning and implementing devops practices(linux basic, ssh configuration, docker, github actions - ci/cd)",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc && cp -R views dist/views",
    "dev": "tsx --watch ./index.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "npx eslint .",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bvvinaykumar45/bloggy-devops.git"
  },
  "keywords": [
    "dockerfile",
    "github",
    "actions",
    "bash",
    "script"
  ],
  "author": "bvvinaykumar",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bvvinaykumar45/bloggy-devops/issues"
  },
  "homepage": "https://github.com/bvvinaykumar45/bloggy-devops#readme",
  "dependencies": {
    "dotenv": "^17.3.1",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "mysql2": "^3.17.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
